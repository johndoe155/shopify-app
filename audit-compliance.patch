+
+export interface UnitSalePriceAssessment {
+  applicable: boolean;
+  /** What the pack should declare, when the app can work it out. */
+  expected: number | null;
+  label: string | null;
+  /** Why the declaration is not required, when it is not. */
+  exemption: string | null;
