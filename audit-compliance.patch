+  CONSTRAINT "Complaint_pkey" PRIMARY KEY ("id")
+);
+
+CREATE INDEX IF NOT EXISTS "Complaint_shopId_receivedAt_idx"
+  ON "Complaint" ("shopId", "receivedAt");
+
+DO $$
+BEGIN
+  IF NOT EXISTS (
