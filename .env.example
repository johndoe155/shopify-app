# ---------------------------------------------------------------------------
# Shopify
# ---------------------------------------------------------------------------
# From the Partner dashboard -> App setup. `shopify app config link` fills these
# into shopify.app.toml; the environment variables below are what the running
# app reads. Every value here is validated at boot: in production the app
# refuses to serve requests while a value is missing or still a placeholder
# (see app/config.server.ts and `npm run check:config`).
SHOPIFY_API_KEY=REPLACE_WITH_CLIENT_ID
SHOPIFY_API_SECRET=REPLACE_WITH_API_SECRET
SCOPES=read_products,write_products
SHOPIFY_APP_URL=https://REPLACE_WITH_HOST
# Optional emergency pin. Must be a version this SDK knows (2026-10 is current).
# SHOPIFY_API_VERSION=2026-10

# ---------------------------------------------------------------------------
# Database (Postgres)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legal_mrp?schema=public

# ---------------------------------------------------------------------------
# Jobs (durable queue)
# ---------------------------------------------------------------------------
# Shared secret for the scheduled-job endpoints (/api/jobs/nightly and
# /api/jobs/tick). Send it as `x-jobs-secret` or `Authorization: Bearer <secret>`.
JOBS_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
# Optional cron expressions used by the host scheduler (documented in README).
JOBS_NIGHTLY_CRON=0 2 * * *
JOBS_TICK_CRON=* * * * *
# Worker tuning. JOBS_WORKER=off disables the in-process worker when you run
# `npm run jobs:worker` as a separate process or drive ticks from cron.
JOBS_LEASE_MS=300000
JOBS_POLL_MS=15000
JOBS_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Demo / preview mode (local only, never enable in production)
# ---------------------------------------------------------------------------
# DEMO_MODE=1 serves the full Polaris admin UI with a seeded in-memory store so
# the app can be reviewed without a Shopify dev store or a database. It is
# refused when NODE_ENV=production (see app/config.server.ts).
DEMO_MODE=0
# Opt-in required to serve the preview store with NODE_ENV=production. `npm run
# demo` sets this itself; a real deployment must leave both unset/0.
DEMO_MODE_SECRET=
PORT=3000

# ---------------------------------------------------------------------------
# Merchant-facing support
# ---------------------------------------------------------------------------
# Shown on the Help page and in exports. Leave empty and the UI hides the
# address instead of showing a placeholder.
SUPPORT_EMAIL=
# The review link for THIS app, e.g.
# https://apps.shopify.com/YOUR-APP-HANDLE/reviews/new
# Leave empty and the review prompt is shown without a button.
SHOPIFY_APP_REVIEW_URL=
