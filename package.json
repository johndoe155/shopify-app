{
  "name": "india-legal-metrology-mrp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "shopify app dev",
    "dev:server": "react-router dev",
    "demo": "npm run build && node scripts/serve-demo.mjs",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "setup": "prisma generate && prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0 && npm run check:words",
    "check:words": "tsx scripts/check-forbidden-words.ts",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "mrr": "tsx scripts/mrr.ts",
    "seed": "tsx scripts/seed-dev-store.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "jobs:worker": "tsx scripts/jobs-worker.ts",
    "check:config": "tsx scripts/check-config.ts",
    "release:check": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:listing && npm run audit:prod && npm run check:config",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check:listing": "tsx scripts/check-listing.ts",
    "verify:live": "tsx scripts/live-smoke.ts",
    "spike": "tsx scripts/spikes.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-router/node": "^7.18.5",
    "@react-router/serve": "^7.18.5",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/polaris": "^13.9.0",
    "@shopify/shopify-app-react-router": "^4.0.0",
    "@shopify/shopify-app-session-storage-prisma": "^11.0.1",
    "dotenv": "^16.4.5",
    "isbot": "^5.1.17",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.1.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^7.1.1",
    "@shopify/cli": "^3.72.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "liquidjs": "^10.30.1",
    "playwright": "^1.64.1",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "@shopify/cli": {
      "esbuild": "^0.28.2"
    }
  }
}
